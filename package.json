{
  "name": "github-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:build": "npm run build && node desktop/prepare.cjs",
    "desktop:start": "node node_modules/electron/install.js && electron .",
    "desktop:package": "npm run desktop:build && electron-builder --publish never",
    "data:export": "node desktop/transfer.cjs",
    "test:desktop": "node --test desktop/data.node-test.cjs",
    "desktop:smoke": "node node_modules/electron/install.js && electron . --smoke-test"
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "main": "desktop/main.cjs",
  "description": "Personal GitHub activity dashboard for Windows and macOS",
  "author": "maruyamamasaya"
}
